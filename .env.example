# Backend API origin. Defaults to `<page host>:5000` when unset.
VITE_API_BASE=http://127.0.0.1:5000

# cbBTC price WebSocket served by backend/ws.py.
VITE_CBBTC_WS_URL=ws://127.0.0.1:8765

# WalletConnect Cloud project id. Optional: injected (Rabby/MetaMask) and
# Coinbase wallets keep working without it; the WalletConnect connector is dropped.
VITE_WALLETCONNECT_PROJECT_ID=

# Supabase project used for public, read-only market data.
# Use the publishable (anon) key — never the service_role key in the frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
